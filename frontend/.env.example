# Supabase project settings (Project Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL of the Micronaut backend API. Server-only: never exposed to the
# browser bundle, used exclusively by the Next.js BFF route handlers under
# src/app/api/**.
BACKEND_API_URL=http://localhost:8080
