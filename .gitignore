# Root gitignore for household-organizer monorepo

# Frontend (Next.js)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/*.tsbuildinfo
frontend/next-env.d.ts
frontend/.vercel

# Backend (Micronaut/Gradle)
backend/.gradle/
backend/build/
backend/target/
backend/out/
backend/.micronaut/
backend/.kotlin/

# IDE
.idea/
*.iml
*.ipr
*.iws
.project
.settings/
.classpath
.factorypath
.vscode/

# Env & secrets
.env
.env.*
!.env.example
*.pem

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
