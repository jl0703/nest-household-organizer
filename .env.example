# Copy to .env and fill in real values before running `docker compose up`.

# Postgres
POSTGRES_DB=household
POSTGRES_USER=household
POSTGRES_PASSWORD=household

# Backend (Micronaut)
SUPABASE_JWT_SECRET=replace-me-with-your-supabase-jwt-secret

# Frontend (Next.js) - NEXT_PUBLIC_* values are baked into the client bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
